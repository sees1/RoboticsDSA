<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- body defining macro -->
  <xacro:macro name="body" params="wheel_radius">
    <xacro:include filename="../common/sensors/imu.urdf.xacro"/>
    <xacro:include filename="../common/sensors/asus_xtion.urdf.xacro"/>
    <xacro:include filename="../common/sensors/hokuyo.urdf.xacro"/>

    <link name="base_footprint" />
    <joint name="base_footprint_joint" type="fixed">
      <parent link="base_footprint" />
      <child link="base_link" />
    </joint>
    <link name="base_link" />

    <joint name="base_to_body_joint" type="fixed">
      <origin xyz="0.0 0.0 ${wheel_radius}" rpy="0.0 0.0 0.0" />
      <parent link="base_link" />
      <child link="body_link" />
    </joint>

    <link name="body_link">
      <visual>
        <origin xyz="0.0 0.0 -0.0173" rpy="${pi/2} 0.0 ${pi/2}" />
        <geometry>
          <mesh filename="file://$(find test_environment)/meshes/diff/body.dae" scale="0.001 0.001 0.001" />
        </geometry>
      </visual>

      <collision>
        <geometry>
          <box size="0.197 0.150 0.080" />
        </geometry>
        <origin xyz="0.0 0.0 ${0.040 - 0.02}" rpy="0.0 0.0 0.0" />
      </collision>

      <inertial>
        <mass value="1.728" />
        <inertia ixx="0.004162" ixy="0.0"     ixz="0.0"
                                iyy="0.00651" iyz="0.0"
                                              izz="0.008828" />
        <origin xyz="0.0 0.0 ${0.040 - 0.02}" rpy="0.0 0.0 0.0" />
      </inertial>
    </link>

    <joint name="body_to_cover_joint" type="fixed">
      <origin xyz="0.0 0.0 0.0603" rpy="0.0 0.0 0.0" />
      <parent link="body_link" />
      <child link="cover_link" />
    </joint>

    <link name="cover_link" />

    <xacro:sensor_hokuyo prefix="laser" parent="body_link">
      <origin xyz="0.07 0 0.08" rpy="0 0 0"/>
    </xacro:sensor_hokuyo>
    <xacro:sensor_imu prefix="imu" parent="body_link">
        <origin xyz="0.003 -0.0495 0.04332" rpy="0.0 0.0 0.0" />
    </xacro:sensor_imu>

  </xacro:macro>
</robot>
