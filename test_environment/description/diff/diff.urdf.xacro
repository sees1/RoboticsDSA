<?xml version='1.0'?>
<robot name="diff" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <material name="blue"><color rgba="0 0 1 1" /></material>
  <!-- PROPERTIES -->
  <xacro:property name="wheel_radius" value="0.0425" />

  <!-- INCLUDE ROBOT MACRO -->
  <xacro:include filename="ros2_control.urdf.xacro"/>
  <xacro:include filename="body.urdf.xacro"/>
  <xacro:include filename="wheel.urdf.xacro"/>

  <!-- BODY -->
  <xacro:body wheel_radius="${wheel_radius}"/>

  <!-- WHEEL -->
  <xacro:wheel wheel_radius="${wheel_radius}" side="fl"/>
  <xacro:wheel wheel_radius="${wheel_radius}" side="fr"/>
  <xacro:wheel wheel_radius="${wheel_radius}" side="rl"/>
  <xacro:wheel wheel_radius="${wheel_radius}" side="rr"/>

  <!-- GAZEBO PLUGINS -->
  <xacro:gz_diffbot_system/>
  <xacro:controller config_file="diff" />
</robot>
